PORT=3000
GITHUB_TOKEN=

# GitHub OAuth (optional) - enables "Continue with GitHub" sign in.
# Create an OAuth App at https://github.com/settings/developers and fill these in:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: public base URL of your app (e.g. https://your-app.onrender.com).
# Used to build the OAuth callback URL; not needed for local development.
PUBLIC_BASE_URL=
# Optional: exact callback URL override - must match your GitHub OAuth App settings.
# Default is <base-url>/api/auth/github/callback.
GITHUB_REDIRECT_URI=
JWT_SECRET=change-this-to-a-long-random-string
DATABASE_URL=

# Leave DATABASE_URL empty for local SQLite (data/app.db).
# Set DATABASE_URL for PostgreSQL (Render, Neon, Supabase, etc.).

# Set PGSSL=false only if your Postgres provider does not require SSL locally.
PGSSL=
